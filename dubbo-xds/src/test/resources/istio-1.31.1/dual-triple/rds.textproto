name: "outbound|7070||echo-dual.dubbo-xds-test.svc.cluster.local"
virtual_hosts {
  name: "echo-dual.dubbo-xds-test.svc.cluster.local:7070"
  domains: "echo-dual.dubbo-xds-test.svc.cluster.local"
  domains: "echo-dual.dubbo-xds-test.svc.cluster.local:7070"
  domains: "echo-dual.dubbo-xds-test.svc.cluster.local."
  domains: "echo-dual.dubbo-xds-test.svc.cluster.local.:7070"
  domains: "echo-dual"
  domains: "echo-dual:7070"
  domains: "echo-dual.dubbo-xds-test.svc"
  domains: "echo-dual.dubbo-xds-test.svc:7070"
  domains: "echo-dual.dubbo-xds-test"
  domains: "echo-dual.dubbo-xds-test:7070"
  domains: "10.0.7.36"
  domains: "10.0.7.36:7070"
  routes {
    match {
      prefix: "/"
    }
    route {
      cluster: "outbound|7070||echo-dual.dubbo-xds-test.svc.cluster.local"
      timeout {
      }
      retry_policy {
        retry_on: "connect-failure,refused-stream,unavailable,cancelled,retriable-status-codes"
        num_retries {
          value: 2
        }
        retry_host_predicate {
          name: "envoy.retry_host_predicates.previous_hosts"
          typed_config {
            type_url: "type.googleapis.com/envoy.extensions.retry.host.previous_hosts.v3.PreviousHostsPredicate"
          }
        }
        host_selection_retry_max_attempts: 5
      }
      max_grpc_timeout {
      }
    }
    decorator {
      operation: "echo-dual.dubbo-xds-test.svc.cluster.local:7070/*"
    }
    name: "default"
  }
  include_request_attempt_count: true
}
