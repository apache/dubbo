name: "outbound|7070||echo-maglev.dubbo-xds-test.svc.cluster.local"
virtual_hosts {
  name: "echo-maglev.dubbo-xds-test.svc.cluster.local:7070"
  domains: "echo-maglev.dubbo-xds-test.svc.cluster.local"
  domains: "echo-maglev.dubbo-xds-test.svc.cluster.local:7070"
  domains: "echo-maglev.dubbo-xds-test.svc.cluster.local."
  domains: "echo-maglev.dubbo-xds-test.svc.cluster.local.:7070"
  domains: "echo-maglev"
  domains: "echo-maglev:7070"
  domains: "echo-maglev.dubbo-xds-test.svc"
  domains: "echo-maglev.dubbo-xds-test.svc:7070"
  domains: "echo-maglev.dubbo-xds-test"
  domains: "echo-maglev.dubbo-xds-test:7070"
  domains: "10.0.84.27"
  domains: "10.0.84.27:7070"
  routes {
    match {
      prefix: "/"
    }
    route {
      cluster: "outbound|7070||echo-maglev.dubbo-xds-test.svc.cluster.local"
      timeout {
      }
      retry_policy {
        retry_on: "connect-failure,refused-stream,unavailable,cancelled,retriable-status-codes"
        num_retries {
          value: 2
        }
        host_selection_retry_max_attempts: 5
      }
      hash_policy {
        header {
          header_name: "x-user"
        }
      }
      max_stream_duration {
        max_stream_duration {
        }
      }
    }
    metadata {
      filter_metadata {
        key: "istio"
        value {
          fields {
            key: "config"
            value {
              string_value: "/apis/networking.istio.io/v1/namespaces/dubbo-xds-test/virtual-service/echo-maglev"
            }
          }
        }
      }
    }
    decorator {
      operation: "echo-maglev.dubbo-xds-test.svc.cluster.local:7070/*"
    }
  }
  include_request_attempt_count: true
}
