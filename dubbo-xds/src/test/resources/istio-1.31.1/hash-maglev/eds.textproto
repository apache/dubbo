cluster_name: "outbound|7070||echo-maglev.dubbo-xds-test.svc.cluster.local"
endpoints {
  locality {
    region: "us-east-1"
    zone: "us-east-1b"
  }
  lb_endpoints {
    endpoint {
      address {
        socket_address {
          address: "172.20.158.98"
          port_value: 17070
        }
      }
    }
    health_status: HEALTHY
    metadata {
      filter_metadata {
        key: "istio"
        value {
          fields {
            key: "workload"
            value {
              string_value: "echo-v1;dubbo-xds-test;xds-echo;v1;Kubernetes"
            }
          }
        }
      }
    }
    load_balancing_weight {
      value: 1
    }
  }
  lb_endpoints {
    endpoint {
      address {
        socket_address {
          address: "172.20.158.99"
          port_value: 17070
        }
      }
    }
    health_status: HEALTHY
    metadata {
      filter_metadata {
        key: "istio"
        value {
          fields {
            key: "workload"
            value {
              string_value: "echo-v2;dubbo-xds-test;xds-echo;v2;Kubernetes"
            }
          }
        }
      }
    }
    load_balancing_weight {
      value: 1
    }
  }
  load_balancing_weight {
    value: 2
  }
}
